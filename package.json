{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/generate-build-info.js",
    "dev": "next dev -p 9002",
    "dev:clean": "rm -rf .next && npm run dev",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "dev:deals-flow": "tsx src/ai/dev-deals.ts",
    "dev:products-flow": "tsx src/ai/dev-products.ts",
    "prebuild": "node ./scripts/generate-build-info.js",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "test": "echo \"No tests specified\" && exit 0",
    "typecheck": "tsc --noEmit",
    "verify:autopilot-path": "node ./scripts/verify-autopilot-harvester-path.mjs",
    "verify:aliexpress-promotions": "node ./scripts/verify-aliexpress-promotion-pipeline.mjs",
    "verify:indexing-future-content": "node ./scripts/verify-indexing-future-content.mjs",
    "smoke:aliexpress-promotions": "tsx scripts/smoke-aliexpress-promotions.ts",
    "monitor:aliexpress-promotions": "tsx scripts/smoke-aliexpress-promotions.ts --min-signals=1",
    "verify:future-content": "npm run verify:aliexpress-promotions && npm run verify:indexing-future-content && npm run verify:autopilot-path && npm run typecheck",
    "backfill:aliexpress-promotions": "tsx scripts/backfill-aliexpress-promotions.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:interactions": "ts-node src/scripts/seed-interactions.ts",
    "seed:categories": "tsx src/scripts/seed-categories-full.ts",
    "seed:import-profiles": "tsx src/scripts/seed-import-profiles.ts",
    "auto-import": "tsx src/scripts/auto-import-products.ts",
    "backfill:master-data": "tsx src/scripts/master-data-backfill.ts",
    "backfill:master-data:apply": "tsx src/scripts/master-data-backfill.ts --apply",
    "backfill:translations": "tsx scripts/backfill-missing-translations.ts",
    "backfill:translations:apply": "tsx scripts/backfill-missing-translations.ts --apply",
    "backfill:translations:deals": "tsx scripts/backfill-missing-translations.ts --only=deals",
    "backfill:translations:deals:apply": "tsx scripts/backfill-missing-translations.ts --apply --only=deals",
    "backfill:translations:products": "tsx scripts/backfill-missing-translations.ts --only=products",
    "backfill:translations:products:apply": "tsx scripts/backfill-missing-translations.ts --apply --only=products",
    "backfill:images": "tsx scripts/backfill-aliexpress-images.ts",
    "backfill:images:apply": "tsx scripts/backfill-aliexpress-images.ts --apply",
    "reset:m6:canonical": "tsx scripts/reset-m6-canonical.ts",
    "canary:m6:mechanism": "tsx scripts/canary-m6-mechanism.ts",
    "audit:aliexpress": "tsx scripts/audit-aliexpress-import-completeness.ts",
    "audit:aliexpress:strict": "tsx scripts/audit-aliexpress-import-completeness.ts --strict",
    "report:tools": "node scripts/generate-tools-inventory.mjs",
    "typesense:sync": "ts-node src/scripts/typesense-sync.ts",
    "typesense:sync:full": "ts-node src/scripts/typesense-sync.ts",
    "postinstall": "node ./scripts/apply-react-hooks-shim.js || true && patch-package",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm --prefix okazje-plus run build && firebase deploy --only functions",
    "deploy:prod": "npm run build && npm --prefix okazje-plus run build && firebase deploy --only hosting,functions"
  },
  "dependencies": {
    "@genkit-ai/ai": "^1.24.0",
    "@genkit-ai/next": "^1.24.0",
    "@genkit-ai/vertexai": "^1.24.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@swc/helpers": "^0.5.17",
    "@types/cheerio": "^0.22.35",
    "@types/papaparse": "^5.5.0",
    "@types/uuid": "^10.0.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "genkit": "^1.24.0",
    "googleapis": "^167.0.0",
    "ioredis": "^5.8.2",
    "isomorphic-dompurify": "^2.33.0",
    "lru-cache": "^10.0.0",
    "lucide-react": "^0.475.0",
    "next": "15.3.6",
    "next-intl": "^4.5.5",
    "papaparse": "^5.5.3",
    "patch-package": "^8.0.0",
    "puppeteer": "^24.32.0",
    "react": "18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-hook-form": "^7.71.0",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-window": "^2.2.5",
    "recharts": "^2.15.4",
    "sharp": "0.33.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typesense": "^2.1.0",
    "uuid": "^13.0.0",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "autoprefixer": "^10.4.24",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "genkit-cli": "^1.24.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.19",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "zod-validation-error": "^3.5.0"
  },
  "optionalDependencies": {
    "fsevents": "2.3.3"
  }
}
