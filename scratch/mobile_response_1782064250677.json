s-media.com/kf/S4a5c428b1e30462d8ea40dcc1a124fdeX.jpg_640x640.jpg_.webp"],"12000055921305490":["https://ae-pic-a1.aliexpress-media.com/kf/Sbdf156cd43f14c82bdfd16610586c642b.jpg_640x640.jpg_.webp"],"12000058268424629":["https://ae-pic-a1.aliexpress-media.com/kf/S4a5c428b1e30462d8ea40dcc1a124fdeX.jpg_640x640.jpg_.webp"],"12000058268424630":["https://ae-pic-a1.aliexpress-media.com/kf/Sbc65fd3d9b7044389a2774699d3e2589X.jpg_640x640.jpg_.webp"],"12000055921305489":["https://ae-pic-a1.aliexpress-media.com/kf/S467cc31d29d546b09f30e497cc8f6946f.jpg_640x640.jpg_.webp"],"12000058268424631":["https://ae-pic-a1.aliexpress-media.com/kf/S22e5cbb64b1a48cea00c8dc08e4e46ebh.jpg_640x640.jpg_.webp"],"12000055921305488":["https://ae-pic-a1.aliexpress-media.com/kf/S22e5cbb64b1a48cea00c8dc08e4e46ebh.jpg_640x640.jpg_.webp"]},"supportAnimation":true},"GALLERY":{"evaTotalNum":27,"evaluationItemDTOS":[{"buyerEval":100,"buyerFeedback":"Veľmi pekná a priestranná chladnička, jednoduchá a funkčná bluetooth aplikácia kde si nastavíte jednotlivé zóny. Dokocnca ide nastaviť aj väčší priestor na -20 takže sa dá použiť ako mraznička (zatiaľ som to neskúšal) kompresor má pomerne tichý chod. Na dne chladničky je vypúšťací otvor čo uľahčí čistenie. Zdá sa že Vevor vykonal dobrú prácu.","buyerTranslationFeedback":"Bardzo ładna i pojemna lodówka, z prostą i funkcjonalną aplikacją Bluetooth, za pomocą której można ustawić indywidualne strefy. Można ją nawet ustawić na wyższą temperaturę, do -20 stopni, dzięki czemu można ją używać jako zamrażarki (tego jeszcze nie próbowałem). Kompresor pracuje dość cicho. Na dole lodówki znajduje się otwór odpływowy, co ułatwia czyszczenie. Wygląda na to, że Vevor wykonał dobrą robotę.","evalDate":"12 MAR 2026","evaluationId":30101693395476153,"finalBuyerFeedback":"Bardzo ładna i pojemna lodówka, z prostą i funkcjonalną aplikacją Bluetooth, za pomocą której można ustawić indywidualne strefy. Można ją nawet ustawić na wyższą temperaturę, do -20 stopni, dzięki czemu można ją używać jako zamrażarki (tego jeszcze nie próbowałem). Kompresor pracuje dość cicho. Na dole lodówki znajduje się otwór odpływowy, co ułatwia czyszczenie. Wygląda na to, że Vevor wykonał dobrą robotę.","reviewStar":"5.0"},{"buyerEval":100,"buyerFeedback":"Llego en siete días y muy bien embalado. Pesa un poco pero enfría rápido y congela muy bien. No suelta calor ni tampoco vibra mucho. Estoy muy contenta porque era un regalo para mi marido. \nA mi marido le encanta . Está genial. Ña recomiendo un 100%. El tamaño que cogí es de 30 litros pero caben un montón de cosas.","buyerTranslationFeedback":"Dotarło w ciągu siedmiu dni i było bardzo dobrze zapakowane. Waży trochę, ale szybko schładza i zamraża bardzo dobrze. Nie wydziela ciepła ani nie wibruje zbytnio. Jestem bardzo szczęśliwa, ponieważ to był prezent dla mojego męża. \n Mój mąż to uwielbia. To jest świetne. Polecam to w 100%. Rozmiar, który wybrałem, to 30 litrów, ale zmieści się w nim wiele rzeczy.","evalDate":"19 LIP 2025","evaluationId":30091306236793878,"finalBuyerFeedback":"Dotarło w ciągu siedmiu dni i było bardzo dobrze zapakowane. Waży trochę, ale szybko schładza i zamraża bardzo dobrze. Nie wydziela ciepła ani nie wibruje zbytnio. Jestem bardzo szczęśliwa, ponieważ to był prezent dla mojego męża. \n Mój mąż to uwielbia. To jest świetne. Polecam to w 100%. Rozmiar, który wybrałem, to 30 litrów, ale zmieści się w nim wiele rzeczy.","images":["https://ae-pic-a1.aliexpress-media.com/kf/Afe2e2a298ce0406b829bb8ada444afabT.jpg","https://ae-pic-a1.aliexpress-media.com/kf/A63da1f318d334edb971efd1c4f3233ceA.jpg","https://ae-pic-a1.aliexpress-media.com/kf/A806f30a0e0694bfdb26ac23c321f76c70.jpg","https://ae-pic-a1.aliexpress-media.com/kf/Ad6b7fb06d9b344c88c475414ab1a1d032.jpg"],"reviewStar":"5.0","thumbnails":["http://ae-pic-a1.aliexpress-media.com/kf/Afe2e2a298ce0406b829bb8ada444afabT.jpg_220x220.jpg","http://ae-pic-a1.aliexpress-media.com/kf/A63da1f318d334edb971efd1c4f3233ceA.jpg_220x220.jpg","http://ae-pic-a1.a